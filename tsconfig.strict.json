{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] },
    "noEmit": true,
    "listFiles": false,
    "skipLibCheck": true,
    "strictNullChecks": true
  },
  "include": ["src/vr/**/*.ts", "src/loaders/**/*.ts"],
  "exclude": ["node_modules", "src/**/*.spec.ts"]
}
